<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_gava_api_search" model="ir.ui.view">
        <field name="name">gava.api.search</field>
        <field name="model">gava.api</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="api_endpoint_id"/>
                <field name="client_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Sandbox" name="filter_sandbox" domain="[('state', '=', 'sbx')]"/>
                <filter string="Production" name="filter_production" domain="[('state', '=', 'production')]"/>
                <group>
                    <filter string="Environment" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Endpoint" name="group_by_endpoint" context="{'group_by': 'api_endpoint_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gava_api_list" model="ir.ui.view">
            <field name="name">gava.api.list</field>
            <field name="model">gava.api</field>
            <field name="arch" type="xml">
                <list decoration-muted="not active">
                    <field name="name"/>
                        <field name="state" widget="badge"
                           decoration-warning="state == 'sbx'"
                           decoration-success="state == 'production'"/>
                    <field name="token_status" string="Token" widget="badge"
                           decoration-success="token_status == 'valid'"
                           decoration-danger="token_status == 'expired'"
                           decoration-muted="token_status == 'none'"/>
                    <field name="expires_at"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
    </record>
    <record id="view_gava_api_form" model="ir.ui.view">
        <field name="name">gava.api.form</field>
        <field name="model">gava.api</field>
        <field name="arch" type="xml">
            <form string="Gava API Configuration">
                <header>
                    <button name="action_generate_token" type="object"
                            string="Generate Token" class="btn-primary" icon="fa-key"
                            confirm="This will generate a new access token, replacing the current one. Continue?"/>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '1'}" statusbar_visible="sbx,production"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="description" placeholder="Optional description for this configuration..."/>
                    </div>

                    <group>
                        <group string="Configuration">
                            <field name="api_endpoint_id" options="{'no_create': True}"/>
                            <field name="base_url" widget="url"/>
                            <field name="active"/>
                        </group>

                        <group string="Token Status">
                            <field name="token_status" widget="badge"
                                   decoration-success="token_status == 'valid'"
                                   decoration-danger="token_status == 'expired'"
                                   decoration-muted="token_status == 'none'"/>
                            <field name="expires_at" readonly="1"/>
                        </group>
                    </group>

                    <group string="OAuth2 Credentials">
                        <group>
                            <field name="client_id" password="True"/>
                            <field name="client_secret" password="True"/>
                        </group>
                        <group>
                            <field name="access_token" readonly="1" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gava_api_kanban" model="ir.ui.view">
        <field name="name">gava.api.kanban</field>
        <field name="model">gava.api</field>
        <field name="arch" type="xml">
            <kanban groups_draggable="1">
<!--                default_group_by="state"-->
                <field name="name"/>
                <field name="api_endpoint_id"/>
                <field name="state"/>
                <field name="active"/>
                <field name="description"/>
                <field name="expires_at"/>
                <field name="token_status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="fs-5">
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.state.raw_value == 'production'"
                                      class="badge rounded-pill text-bg-success">Production</span>
                                <span t-if="record.state.raw_value == 'sbx'"
                                      class="badge rounded-pill text-bg-warning">Sandbox</span>
                            </div>

                            <div t-if="record.description.value" class="text-muted mb-2">
                                <field name="description"/>
                            </div>

                            <div class="mb-2 text-muted">
                                <i class="fa fa-link me-1">
                                <field name="api_endpoint_id"/>
                                </i>
                            </div>

                            <div class="mt-3 border-top pt-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">
                                        <i class="fa fa-clock-o me-1">Token Expiry</i>
                                    </small>
                                    <div>
                                        <field name="expires_at"/>
                                    </div>
                                </div>
                                <span t-if="record.token_status.raw_value == 'valid'"
                                      class="badge text-bg-success">Valid</span>
                                <span t-if="record.token_status.raw_value == 'expired'"
                                      class="badge text-bg-danger">Expired</span>
                                <span t-if="record.token_status.raw_value == 'none'"
                                      class="badge text-bg-secondary">Not Generated</span>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gava_api" model="ir.actions.act_window">
        <field name="name">API Credentials</field>
        <field name="res_model">gava.api</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_gava_api_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up a new Gava Connect API credential
            </p>
            <p>
                Configure OAuth2 client credentials for each KRA Gava Connect
                endpoint you want to integrate with.
            </p>
        </field>
    </record>
</odoo>
