<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form_gava_inherit" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.gava</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="replace">

            </xpath>

            <notebook position="inside">
                <page string="Tax Compliance (KRA)" name="kra_tax_compliance">
                    <div class="alert alert-warning d-flex align-items-center" role="alert"
                         invisible="kra_validation_status not in ('Suspended', 'Cancelled', 'Stopped')">
                        <i class="fa fa-exclamation-triangle me-2">
                        This contact's KRA PIN status requires review.
                        </i>
                    </div>

                    <group>
                        <group string="Tax PIN Information">
                            <label for="vat"/>
                            <div class="o_row">
                                <field name="vat" placeholder="e.g. A123456789Z"/>
                                <button name="action_validate_kra_pin" type="object"
                                        string="Verify" icon="fa-shield" class="btn-secondary ms-2"/>
<!--                                <button name="action_it_exemption_checker" type="object"-->
<!--                                        string="IT Exemption Checker" icon="fa-shield"-->
<!--                                        class="btn-secondary ms-2"/>-->
                            </div>

                            <field name="kra_validation_status" widget="badge"
                                   decoration-success="kra_validation_status == 'Active'"
                                   decoration-warning="kra_validation_status == 'Suspended'"
                                   decoration-danger="kra_validation_status in ('Cancelled', 'Stopped')"/>
                            <field name="kra_taxpayer_name" placeholder="Populated after verification"/>
                            <field name="type_of_taxpayer" placeholder="Populated after verification"/>

                            <label for="tax_service_station"/>
                            <div class="o_row">
                                <field name="tax_service_station"/>
                                <button name="action_know_kra_station" type="object"
                                        string="Find Station" icon="fa-search" class="btn-secondary ms-2"/>
                            </div>
                        </group>

                        <group string="PIN Registration &amp; Retrieval">
                            <field name="taxpayer_type"/>

                            <label for="tax_payerid"/>
                            <div class="o_row">
                                <field name="tax_payerid"/>
                                <button name="action_retrieve_kra_pin" type="object"
                                        string="Retrieve PIN" icon="fa-search" class="btn-secondary ms-2"/>
                            </div>

                            <field name="taxpayer_dob"/>
                            <field name="is_pin_with_no_oblig" widget="boolean_toggle"/>

                            <button name="action_pin_registration" type="object"
                                    string="Register New PIN" icon="fa-id-card"
                                    class="btn-primary mt-2"
                                    confirm="This will submit a new KRA PIN registration request. Continue?"/>
                        </group>
                    </group>
                    <group string="Income Tax Exemption">
                        <group>
                            <button name="action_it_exemption_checker"
                                    type="object"
                                    string="Income Tax Exemption Checker"
                                    icon="fa-shield"
                                    class="btn-secondary mt-2"/>
                            <separator/>
                            <field name="it_exemption_status"
                                   widget="boolean_toggle" readonly="1"/>
                            <field name="it_exemption_cert_no" readonly="1"/>
                            <field name="it_exemption_effective_date"
                                   placeholder="Populated after check" readonly="1"/>
                            <field name="it_exemption_expiry_date"
                                   placeholder="Populated after check" readonly="1"/>
                            <field name="it_exemption_issue_date"
                                   placeholder="Populated after check" readonly="1"/>
                        </group>
                        <group>
                            <label for="tcc_reason"/>
                            <div class="o_row">
                                <field name="tcc_reason"/>
                                <button name="action_tcc_application" type="object"
                                        string="TCC Application"
                                        class="btn-secondary ms-2"/>
                            </div>
                            <field name="ack_number"/>
                            <label for="tcc_number"/>
                            <div class="o_row">
                                <field name="tcc_number"/>
                                <button name="action_tcc_checker" type="object"
                                        string="TCC Checker"
                                        class="btn-secondary ms-2"/>
                            </div>
                        </group>
                    </group>
<!--                    <group string="Excise Licence">-->
<!--                        <group>-->
<!--                            <label for="vat" string="Tax Payer PIN"/>-->
<!--                            <div class="o_row">-->
<!--                                <field name="vat" />-->
<!--                                <button name="action_excise_licence_checker_by_pin"-->
<!--                                        type="object"-->
<!--                                        string="Check Excise Licence"-->
<!--                                        icon="fa-shield"-->
<!--                                        class="btn-secondary ms-2"/>-->
<!--                            </div>-->
<!--                            <field name="trading_business_name" readonly="1"-->
<!--                                   force_save="1"/>-->
<!--                            <field name="is_small_brewer" readonly="1" force_save="1"/>-->
<!--                            <field name="goods_class" readonly="1" force_save="1"/>-->
<!--                            <field name="excise_licence_status" readonly="1"-->
<!--                                   force_save="1" widget="badge"-->
<!--                                   decoration-success="excise_licence_status == 'Approved'"-->
<!--                                   decoration-danger="excise_licence_status == 'Rejected'"-->
<!--                                   decoration-warning="excise_licence_status == 'Pending'"/>-->
<!--                            <field name="excise_licence_issue_date" readonly="1" force_save="1"/>-->
<!--                            <label for="excise_licence_no"/>-->
<!--                            <div class="o_row">-->
<!--                                <field name="excise_licence_no"/>-->
<!--                                <button name="action_excise_licence_checker_by_num"-->
<!--                                        type="object"-->
<!--                                        string="Check Excise Licence by Number"-->
<!--                                        icon="fa-shield"-->
<!--                                        class="btn-secondary ms-2"/>-->
<!--                            </div>-->
<!--                            <field name="excise_licence_last_checked" readonly="1"-->
<!--                                   force_save="1"/>-->

<!--                        </group>-->
<!--                        <group></group>-->
<!--                    </group>-->
<!--                        <group string="Import Certificate">-->
<!--                            <label for="import_certificate_no"/>-->
<!--                               <div class="o_row">-->
<!--                                   <field name="import_certificate_no"/>-->
<!--                               </div>-->
<!--                            <field name="import_certificate_status" readonly="1"/>-->
<!--                            <field name="import_certificate_issue_date" readonly="1"/>-->
<!--                            <field name="product_code" readonly="1"/>-->
<!--                        </group>-->
                    <notebook>
                        <page string="Tax Obligations">
                            <group>
                                <button name="fetch_tax_obligation" type="object"
                                        string="Fetch Tax Obligation"/>
                            </group>
                            <group>
                                <field name="tax_obligation_ids" nolabel="1"
                                       readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="obligationid" optional="hide"/>
                                        <field name="obligation_type"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Import Certificate">
                            <group>
                                <group colspan="4">
                                    <field name="vat" class="fw-bold" readonly="1"
                                           nolabel="1"/>
                                    <button name="action_check_import_certificate_by_pin"
                                            type="object"
                                            string="Import Certificate Checker By PIN"
                                            icon="fa-id-card"
                                            class="btn-secondary ms-2"
                                            help="Validate the import certificate using the partner's KRA PIN."/>
                                </group>
                            </group>
                            <group>
                                <field name="certificate_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="certificate_no"/>
                                        <field name="issue_date" readonly="1"
                                               force_save="1"/>
                                        <field name="product_code" readonly="1"
                                               force_save="1"/>
                                        <field name="status" readonly="1" widget="badge"
                                               decoration-success="status == 'Approved'"
                                               decoration-warning="status == 'Pending'"
                                               decoration-danger="status == 'Rejected'"
                                               force_save="1"/>
                                        <field name="partner_id"
                                               column_invisible="1" readonly="1"/>
                                        <button name="action_check_import_certificate_by_num"
                                                type="object"
                                                string="Check By Number"
                                                icon="fa-hashtag"
                                                class="btn-secondary ms-2"
                                                help="Validate the import certificate using the Certificate Number."/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="VAT Exemption">
                            <group>
                                <group>
                                    <field name="vat_exemption_certificate_no"/>
                                    <button name="action_check_vat_exemption_certificate"
                                            type="object"
                                            string="Verify VAT Exemption"
                                            class="btn-secondary"
                                            icon="fa-check-circle"/>
                                </group>
                                <group>
                                    <field name="vat_exemption_taxpayer_name"/>
                                    <field name="vat_exemption_last_checked"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="vat_exemption_line_ids"
                                       nolabel="1">
                                    <list editable="bottom">
                                        <field name="cert_no"/>
                                        <field name="issued_date" readonly="1"/>
                                        <field name="status_flag" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Excise Licence">
                            <button name="action_excise_licence_checker_by_pin"
                                    type="object"
                                    string="Check Excise Licence"
                                    icon="fa-shield"
                                    class="btn-secondary ms-2"/>
                            <group>
                                <field name="excise_licence_last_checked"
                                       readonly="1" force_save="1"/>
                            </group>
                            <field name="excise_licence_lines" nolabel="1">
                                <list editable="bottom">
                                    <field name="excise_licence_no"/>
                                    <field name="is_small_brewer" readonly="1"/>
                                    <field name="class_of_goods" readonly="1"/>
                                        <field name="date_of_issue" readonly="1"/>
                                    <field name="status" readonly="1"
                                           force_save="1" widget="badge"
                                           decoration-success="status == 'Approved'"
                                           decoration-danger="status == 'Rejected'"
                                           decoration-warning="status == 'Pending'"/>
                                    <field name="partner_id" column_invisible="1"/>
                                    <button name="action_excise_licence_checker_by_num"
                                            type="object"
                                            string="Check Excise Licence by Number"
                                            icon="fa-shield"
                                            class="btn-secondary ms-2"
                                            invisible="not excise_licence_no"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </notebook>
        </field>
    </record>
</odoo>